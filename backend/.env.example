DATABASE_URL=postgresql://githire:githire@localhost:5432/githire
GEMINI_API_KEY=
# 0 menonaktifkan pembatas aplikasi untuk demo. Set nilai positif saat produksi
# sesuai quota aktif di Google AI Studio.
AI_GLOBAL_REQUESTS_PER_MINUTE=0
AI_CV_PARSE_DAILY_LIMIT=0
AI_ROADMAP_GENERATE_DAILY_LIMIT=0
AI_PORTFOLIO_GENERATE_DAILY_LIMIT=0
AI_COVER_LETTER_DAILY_LIMIT=0
AI_SCREENING_DAILY_LIMIT=0
# Optional: higher GitHub API rate limits
# GITHUB_TOKEN=

# From Clerk Dashboard → JWT / API Keys → JWKS URL & Frontend API (issuer)
CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev

# Comma-separated origins for browser CORS
CORS_ORIGINS=http://localhost:3000
# Comma-separated recruiter accounts allowed to access recruiter features
RECRUITER_EMAILS=
